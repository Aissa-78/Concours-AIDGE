diff --git a/aidge/aidge_core/aidge_core/export_utils/export_utils.py b/aidge/aidge_core/aidge_core/export_utils/export_utils.py
--- a/aidge/aidge_core/aidge_core/export_utils/export_utils.py
+++ b/aidge/aidge_core/aidge_core/export_utils/export_utils.py
@@ -48,7 +48,10 @@ def get_node_from_metaop(node: aidge_core.Node, node_type: str):
     if node.type() == node_type:
         return [node]
     res = []
-    if isinstance(node.get_operator(), aidge_core.MetaOperatorOp):
+    # Some leaf operators (notably Round) abort when get_operator() is called
+    # through these macOS Python bindings. Only inspect known metaoperators.
+    if node.type() in ("@NNPA", "Quantizer", "QFC", "QConv", "QConvDw",
+                       "QConv2D", "QConvDepthWise2D"):
         for n in node.get_operator().get_micro_graph().get_nodes():
             res += get_node_from_metaop(n, node_type)
     return res
